{
  "name": "@node-project-template/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "echo Use npm run dev to start the development environment",
    "dev": "npm run docker:up && npm run mikro:migrate:up && npm run dev-dashboard:navigate && npm run dev-dashboard",
    "dev:startnx": "npm run docker:check && nx run-many --target=serve --projects=api,web --parallel",
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "docker:check": "tsx docker/scripts/check-compose.ts",
    "mikro:migrate:create": "mikro-orm migration:create --config apps/api/mikro-orm.config.ts",
    "mikro:migrate:up": "mikro-orm migration:up --config apps/api/mikro-orm.config.ts",
    "mikro:migrate:down": "mikro-orm migration:down --config apps/api/mikro-orm.config.ts",
    "dev-dashboard": "cd dev-dashboard && npm start",
    "dev-dashboard:navigate": "tsx scripts/open-web.ts http://localhost:4500/"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/build-angular": "~20.3.0",
    "@angular-devkit/core": "~20.3.0",
    "@angular-devkit/schematics": "~20.3.0",
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@angular/language-service": "~20.3.0",
    "@eslint/js": "^9.8.0",
    "@mikro-orm/cli": "^6.6.2",
    "@nx/angular": "22.1.3",
    "@nx/angular-rspack": "22.1.3",
    "@nx/devkit": "22.1.3",
    "@nx/eslint": "22.1.3",
    "@nx/eslint-plugin": "22.1.3",
    "@nx/jest": "22.1.3",
    "@nx/js": "22.1.3",
    "@nx/nest": "22.1.3",
    "@nx/playwright": "22.1.3",
    "@nx/rspack": "22.1.3",
    "@nx/web": "22.1.3",
    "@playwright/test": "^1.36.0",
    "@rspack/cli": "^1.5.0",
    "@rspack/core": "^1.5.0",
    "@rspack/dev-server": "^1.1.4",
    "@schematics/angular": "~20.3.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^20.3.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "~14.6.1",
    "jest-util": "^29.7.0",
    "nx": "22.1.3",
    "prettier": "^2.6.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-merge": "^5.8.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/platform-browser-dynamic": "~20.3.0",
    "@angular/router": "~20.3.0",
    "@mikro-orm/core": "^6.6.2",
    "@mikro-orm/migrations": "^6.6.2",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.6.2",
    "rxjs": "~7.8.0",
    "tsx": "^4.21.0",
    "zone.js": "~0.15.0"
  }
}
