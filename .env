# Copy this file to .env and update with your local settings
# The .env file is gitignored and will not be committed

# Database Configuration
POSTGRES_DB=devdb
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass
POSTGRES_PORT=5432

# Database Connection String (for API)
DATABASE_URL=postgresql://devuser:devpass@localhost:5432/devdb

# API Configuration
API_PORT=6314

# Web Configuration
WEB_PORT=4200

# Dex OAuth Configuration
DEX_ISSUER=http://localhost:5556/dex
DEX_CLIENT_ID_WEB=web-app
DEX_CLIENT_SECRET_WEB=web-app-secret
DEX_CLIENT_ID_API=api-server
DEX_CLIENT_SECRET_API=api-server-secret
DEX_REDIRECT_URI_WEB=http://localhost:4200/auth/callback
DEX_REDIRECT_URI_API=http://localhost:6314/auth/callback

# Environment
NODE_ENV=development
